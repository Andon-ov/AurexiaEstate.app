# ====================================
# Aurexia Estate - Production .env
# ====================================
# Copy this file to .env and fill in the values
# This file goes in the ROOT of the project (next to docker-compose.yml)

# Django Settings
SECRET_KEY=change-me-to-a-random-string
DEBUG=False
ALLOWED_HOSTS=192.168.1.41,localhost,127.0.0.1

# SSL (disable if no domain)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS
CORS_ALLOWED_ORIGINS=http://192.168.1.41:8081,http://localhost:8081

# Aurexia port (avoid conflict with Generix on port 80)
AUREXIA_PORT=8081

# PostgreSQL
POSTGRES_DB=aurexia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Mailjet
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_SENDER_EMAIL=your-email@example.com
MAILJET_SENDER_NAME=Aurexia Estate
RECIPIENT_EMAIL=recipient@example.com
