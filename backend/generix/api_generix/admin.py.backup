        }


@admin.register(ThemeSettings)
class ThemeSettingsAdmin(admin.ModelAdmin):
    """Admin interface for Theme Settings - цветова палитра на сайта"""
    
    form = ThemeSettingsForm
    
    fieldsets = (
        ('Main Brand Colors', {
            'fields': (
                'color_primary_dark',
                'color_primary_light',
                'color_background',
                'color_text',
                'color_white',
            ),
            'description': 'Основни цветове на бранда - тъмносиньо, светлосиньо, фон, текст, бяло'
        }),
        ('Additional Colors', {
            'fields': (
                'color_accent',
                'color_accent_hover',
            ),
            'description': 'Допълнителни акцентни цветове'
        }),
        ('Platform Card Hover Colors', {
            'fields': (
                'color_hover_indigo',
                'color_hover_pink',
                'color_hover_cyan',
            ),
            'description': 'Цветове при hover на platform cards - индиго, розово, циан'
        }),
        ('Semantic Colors', {
            'fields': (
                'color_success',
                'color_warning',
                'color_error',
                'color_info',
            ),
            'description': 'Семантични цветове за съобщения - успех, внимание, грешка, информация'
        }),
        ('Text Colors', {
            'fields': (
                'color_text_dark',
                'color_text_secondary',
            ),
            'description': 'Допълнителни текстови цветове - тъмен текст, вторичен текст'
        }),
        ('Neutral & Gray Colors', {
            'fields': (
                'color_neutral',
                'color_gray_light',
                'color_gray_medium',
                'color_gray_dark',
            ),
            'description': 'Неутрални и сиви цветове - neutral фон, светло/средно/тъмно сиво'
        }),
        ('Border Colors', {
            'fields': (
                'color_border_gray',
            ),
            'description': 'Цветове за borders - сиво border'
        }),
        ('Additional UI Colors', {
            'fields': (
                'color_black',
                'color_background_secondary',
                'color_background_alt',
            ),
            'description': 'Допълнителни UI цветове - черно, вторичен фон, алтернативен фон'
        }),
    )
    
    actions = ['reset_to_default']
    
    # Add custom button to change form
    change_form_template = 'admin/theme_settings_change_form.html'
    
    def has_add_permission(self, request):
        """Singleton - only one instance allowed"""
        return not ThemeSettings.objects.exists()
    
    def has_delete_permission(self, request, obj=None):
        """Prevent deletion of theme settings"""
        return False
    
    def response_change(self, request, obj):
        """Handle custom reset button from change form"""
        if "_reset_to_default" in request.POST:
            # Reset to default colors
            defaults = {
                'color_primary_dark': '#0A1F44',
                'color_primary_light': '#00B2FF',
                'color_background': '#F5F7FA',
                'color_text': '#3C3C3C',
                'color_white': '#FFFFFF',
                'color_accent': '#00B2FF',
                'color_accent_hover': '#0095D9',
                'color_hover_indigo': '#4F46E5',
                'color_hover_pink': '#EC4899',
                'color_hover_cyan': '#06B6D4',
                'color_success': '#10b981',
                'color_warning': '#f59e0b',
                'color_error': '#ef4444',
                'color_info': '#3b82f6',
                'color_text_dark': '#333333',
                'color_text_secondary': '#6B7280',
                'color_neutral': '#F5F7FA',
                'color_gray_light': '#666666',
                'color_gray_medium': '#999999',
                'color_gray_dark': '#555555',
                'color_border_gray': '#e0e0e0',
                'color_black': '#000000',
                'color_background_secondary': '#f5f2f2',
                'color_background_alt': '#E5E7EB',
            }
            
            for field, value in defaults.items():
                setattr(obj, field, value)
            obj.save()
            
            self.message_user(request, "✅ Theme colors have been reset to default values!")
            return super().response_change(request, obj)
        
        return super().response_change(request, obj)
    
    @admin.action(description='🔄 Reset to Default Theme Colors')
    def reset_to_default(self, request, queryset):
        """Reset all theme colors to default values"""
        from django.contrib import messages
        
        # Default color values
        defaults = {
            'color_primary_dark': '#0A1F44',
            'color_primary_light': '#00B2FF',
            'color_background': '#F5F7FA',
            'color_text': '#3C3C3C',
            'color_white': '#FFFFFF',
            'color_accent': '#00B2FF',
            'color_accent_hover': '#0095D9',
            'color_hover_indigo': '#4F46E5',
            'color_hover_pink': '#EC4899',
            'color_hover_cyan': '#06B6D4',
            'color_success': '#10b981',
            'color_warning': '#f59e0b',
            'color_error': '#ef4444',
            'color_info': '#3b82f6',
            'color_text_dark': '#333333',
            'color_text_secondary': '#6B7280',
            'color_neutral': '#F5F7FA',
            'color_gray_light': '#666666',
            'color_gray_medium': '#999999',
            'color_gray_dark': '#555555',
            'color_border_gray': '#e0e0e0',
            'color_black': '#000000',
            'color_background_secondary': '#f5f2f2',
            'color_background_alt': '#E5E7EB',
        }
        
        # Update all selected objects
        count = 0
        for obj in queryset:
            for field, value in defaults.items():
                setattr(obj, field, value)
            obj.save()
            count += 1
        
        messages.success(request, f'✅ Successfully reset {count} theme(s) to default colors!')
        
        self.message_user(
            request,
            f'Theme colors have been reset to default. Please refresh your frontend to see changes.',
            messages.SUCCESS
        )


@admin.register(TestimonialCard)
class TestimonialCardAdmin(admin.ModelAdmin):
    """Admin interface for Testimonial Cards"""
    
    list_display = ['name_en', 'name_bg', 'order', 'is_active', 'updated_at']
    list_filter = ['is_active', 'created_at']
    search_fields = ['name_en', 'name_bg', 'description_en', 'description_bg']
    ordering = ['order', 'id']
    
    fieldsets = (
        ('Logo', {
            'fields': ('logo_url',),
            'description': 'Company/Partner logo image URL'
        }),
        ('English Content', {
            'fields': (
                'name_en',
                'description_en'
            ),
            'description': 'English translations for testimonial'
        }),
        ('Bulgarian Content', {
            'fields': (
                'name_bg',
                'description_bg'
            ),
            'description': 'Български преводи за отзива'
        }),
        ('Settings', {
            'fields': ('order', 'is_active')
        }),
        ('Timestamps', {
            'fields': ('created_at', 'updated_at'),
            'classes': ('collapse',)
        }),
    )
    
    readonly_fields = ['created_at', 'updated_at']
    
    def get_changeform_initial_data(self, request):
        return {
            'order': 0,
            'is_active': True
        }


@admin.register(ContactPageContent)
class ContactPageContentAdmin(admin.ModelAdmin):
    """Admin interface for Contact Page Content"""
    
    fieldsets = (
        ('English Content', {
            'fields': (
                'hero_title_en',
                'title_en',
                'subtitle_en',
                'address_line1_en',
                'address_line2_en',
            ),
            'description': 'English translations for contact page'
        }),
        ('Bulgarian Content', {
            'fields': (
                'hero_title_bg',
                'title_bg',
                'subtitle_bg',
                'address_line1_bg',
                'address_line2_bg',
            ),
            'description': 'Български преводи за контакт страницата'
        }),
        ('Contact Information', {
            'fields': ('email',),
            'description': 'Contact email (same for all languages)'
        }),
        ('Timestamps', {
            'fields': ('updated_at',),
            'classes': ('collapse',)
        }),
    )
    
    readonly_fields = ['updated_at']
    
    def has_add_permission(self, request):
        """Prevent adding new instances - singleton pattern"""
        return not ContactPageContent.objects.exists()
    
    def has_delete_permission(self, request, obj=None):
        """Prevent deletion - singleton pattern"""
        return False


