@admin.register(PlatformFeature)
class PlatformFeatureAdmin(admin.ModelAdmin):
    """Admin interface for Platform Features"""
    
    list_display = ['title_en', 'platform', 'order', 'is_active', 'updated_at']
    list_filter = ['platform', 'is_active', 'created_at']
    search_fields = ['title_en', 'title_bg', 'description_en', 'description_bg']
    ordering = ['platform', 'order', 'id']
    
    fieldsets = (
        ('Platform', {
            'fields': ('platform',),
            'description': 'Select platform (only platforms with is_platform=True are shown)'
        }),
        ('English Content', {
            'fields': (
                'title_en',
                'description_en'
            ),
            'description': 'English translations for feature content'
        }),
        ('Bulgarian Content', {
            'fields': (
                'title_bg',
                'description_bg'
            ),
            'description': 'Български преводи за съдържанието на функционалността'
        }),
        ('Media', {
            'fields': ('icon_url',)
        }),
        ('Settings', {
            'fields': ('order', 'is_active')
        }),
        ('Timestamps', {
            'fields': ('created_at', 'updated_at'),
            'classes': ('collapse',)
        }),
    )
    
    readonly_fields = ['created_at', 'updated_at']
    
    def get_changeform_initial_data(self, request):
        return {
            'order': 0,
            'is_active': True
        }
    
    def save_model(self, request, obj, form, change):
        """
        Override save to show warning if platform has >6 features
        Also catches ValidationError from model and displays it nicely
        """
        try:
            # Check how many active features this platform already has
            if not change:  # Only for new features
                active_count = PlatformFeature.objects.filter(
                    platform=obj.platform,
                    is_active=True
                ).count()
                
                if active_count >= 6:
                    from django.contrib import messages
                    messages.error(
                        request,
                        f'❌ Cannot add feature. "{obj.platform.title_en}" already has {active_count} active features. '
                        f'Maximum is 6 features per platform. Please deactivate an existing feature first.'
                    )
                    return  # Don't save
                elif active_count == 5:
                    from django.contrib import messages
                    messages.warning(
                        request,
                        f'⚠️ This will be the 6th (maximum) feature for "{obj.platform.title_en}".'
                    )
            
            super().save_model(request, obj, form, change)
            
        except Exception as e:
            from django.contrib import messages
            messages.error(request, f'Error saving feature: {str(e)}')


class ThemeSettingsForm(forms.ModelForm):
    """Form with color picker widgets for theme colors"""
    
    class Meta:
        model = ThemeSettings
        fields = '__all__'
        widgets = {
            'color_primary_dark': forms.TextInput(attrs={'type': 'color'}),
            'color_primary_light': forms.TextInput(attrs={'type': 'color'}),
            'color_background': forms.TextInput(attrs={'type': 'color'}),
            'color_text': forms.TextInput(attrs={'type': 'color'}),
            'color_white': forms.TextInput(attrs={'type': 'color'}),
            'color_accent': forms.TextInput(attrs={'type': 'color'}),
            'color_accent_hover': forms.TextInput(attrs={'type': 'color'}),
            'color_hover_indigo': forms.TextInput(attrs={'type': 'color'}),
            'color_hover_pink': forms.TextInput(attrs={'type': 'color'}),
            'color_hover_cyan': forms.TextInput(attrs={'type': 'color'}),
            'color_success': forms.TextInput(attrs={'type': 'color'}),
            'color_warning': forms.TextInput(attrs={'type': 'color'}),
            'color_error': forms.TextInput(attrs={'type': 'color'}),
            'color_info': forms.TextInput(attrs={'type': 'color'}),
            'color_text_dark': forms.TextInput(attrs={'type': 'color'}),
            'color_text_secondary': forms.TextInput(attrs={'type': 'color'}),
            'color_neutral': forms.TextInput(attrs={'type': 'color'}),
            'color_gray_light': forms.TextInput(attrs={'type': 'color'}),
            'color_gray_medium': forms.TextInput(attrs={'type': 'color'}),
            'color_gray_dark': forms.TextInput(attrs={'type': 'color'}),
            'color_border_gray': forms.TextInput(attrs={'type': 'color'}),
