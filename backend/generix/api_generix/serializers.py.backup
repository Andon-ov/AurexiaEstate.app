class PlatformCardSerializer(serializers.ModelSerializer):
    """
    Serializer for PlatformCard model
    Returns data in format matching Angular interface:
    {
        title: string,
        imageUrl: string,
        link: string,
        items: string[],
        hoverColor: string,
        isPlatform: boolean,
        heroTitle?: string,  // Only for platforms
        subtitle?: string    // Only for platforms
    }
    """
    title = serializers.SerializerMethodField()
    imageUrl = serializers.URLField(source='image_url')
    link = serializers.CharField(source='route')
    items = serializers.SerializerMethodField()
    hoverColor = serializers.CharField(source='hover_color')
    isPlatform = serializers.BooleanField(source='is_platform')
    heroTitle = serializers.SerializerMethodField()
    subtitle = serializers.SerializerMethodField()
    
    class Meta:
        model = PlatformCard
        fields = ['title', 'imageUrl', 'link', 'items', 'hoverColor', 'isPlatform', 'heroTitle', 'subtitle']
    
    def get_title(self, obj):
        """Return title based on language from context"""
        lang = self.context.get('lang', 'en')
        return obj.title_bg if lang == 'bg' else obj.title_en
    
    def get_items(self, obj):
        """Return items list based on language from context"""
        lang = self.context.get('lang', 'en')
        return obj.get_items_bg() if lang == 'bg' else obj.get_items_en()
    
    def get_heroTitle(self, obj):
        """Return hero title based on language from context (only for platforms)"""
        if not obj.is_platform:
            return None
        lang = self.context.get('lang', 'en')
        return obj.hero_title_bg if lang == 'bg' else obj.hero_title_en
    
    def get_subtitle(self, obj):
        """Return subtitle based on language from context (only for platforms)"""
        if not obj.is_platform:
            return None
        lang = self.context.get('lang', 'en')
        return obj.subtitle_bg if lang == 'bg' else obj.subtitle_en


class ThemeSettingsSerializer(serializers.ModelSerializer):
    """
    Serializer for ThemeSettings - returns CSS custom properties
    Returns data in format matching CSS variables:
    {
        primaryDark: string,
        primaryLight: string,
        background: string,
        text: string,
        white: string,
        accent: string,
        accentHover: string,
        hoverIndigo: string,
        hoverPink: string,
        hoverCyan: string,
        success: string,
        warning: string,
        error: string,
        info: string,
        textDark: string,
        textSecondary: string,
        neutral: string,
        grayLight: string,
        grayMedium: string,
        grayDark: string,
        borderGray: string,
        black: string,
        backgroundSecondary: string
    }
    """
    primaryDark = serializers.CharField(source='color_primary_dark')
    primaryLight = serializers.CharField(source='color_primary_light')
    background = serializers.CharField(source='color_background')
    text = serializers.CharField(source='color_text')
    white = serializers.CharField(source='color_white')
    accent = serializers.CharField(source='color_accent')
    accentHover = serializers.CharField(source='color_accent_hover')
    hoverIndigo = serializers.CharField(source='color_hover_indigo')
    hoverPink = serializers.CharField(source='color_hover_pink')
    hoverCyan = serializers.CharField(source='color_hover_cyan')
    success = serializers.CharField(source='color_success')
    warning = serializers.CharField(source='color_warning')
    error = serializers.CharField(source='color_error')
    info = serializers.CharField(source='color_info')
    textDark = serializers.CharField(source='color_text_dark')
    textSecondary = serializers.CharField(source='color_text_secondary')
    neutral = serializers.CharField(source='color_neutral')
    grayLight = serializers.CharField(source='color_gray_light')
    grayMedium = serializers.CharField(source='color_gray_medium')
    grayDark = serializers.CharField(source='color_gray_dark')
    borderGray = serializers.CharField(source='color_border_gray')
    black = serializers.CharField(source='color_black')
    backgroundSecondary = serializers.CharField(source='color_background_secondary')
    backgroundAlt = serializers.CharField(source='color_background_alt')
    
    class Meta:
        model = ThemeSettings
        fields = [
            'primaryDark',
            'primaryLight',
            'background',
            'text',
            'white',
            'accent',
            'accentHover',
            'hoverIndigo',
            'hoverPink',
            'hoverCyan',
            'success',
            'warning',
            'error',
            'info',
            'textDark',
            'textSecondary',
            'neutral',
            'grayLight',
            'grayMedium',
            'grayDark',
            'borderGray',
            'black',
            'backgroundSecondary',
            'backgroundAlt'
        ]


