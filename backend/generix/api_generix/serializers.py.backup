class AboutUsImageContentSerializer(serializers.ModelSerializer):
    """
    Serializer for AboutUsImageContent - "Our Purpose" section
    Returns content based on language (en/bg)
    """
    imageUrl = serializers.URLField(source='image_url', allow_blank=True, allow_null=True)
    purposeTitle = serializers.SerializerMethodField()
    purposeDescription = serializers.SerializerMethodField()
    purposeText = serializers.SerializerMethodField()
    
    class Meta:
        model = AboutUsImageContent
        fields = ['imageUrl', 'purposeTitle', 'purposeDescription', 'purposeText']
    
