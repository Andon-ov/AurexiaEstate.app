class HeroSlideSerializer(serializers.ModelSerializer):
    """
    Serializer for HeroSlide model
    Returns data in format matching Angular interface:
    {
        title: string,
        description: string,
        buttonText: string,
        buttonLink: string,
        backgroundImage: string
    }
    """
    title = serializers.SerializerMethodField()
    description = serializers.SerializerMethodField()
    buttonText = serializers.SerializerMethodField()
    buttonLink = serializers.CharField(source='button_link')
    backgroundImage = serializers.URLField(source='background_image')
    
    class Meta:
        model = HeroSlide
        fields = ['title', 'description', 'buttonText', 'buttonLink', 'backgroundImage']
    
    def get_title(self, obj):
        """Return title based on language from context"""
        lang = self.context.get('lang', 'en')
        return obj.title_bg if lang == 'bg' else obj.title_en
    
    def get_description(self, obj):
        """Return description based on language from context"""
        lang = self.context.get('lang', 'en')
        return obj.description_bg if lang == 'bg' else obj.description_en
    
    def get_buttonText(self, obj):
        """Return button text based on language from context"""
        lang = self.context.get('lang', 'en')
        return obj.button_text_bg if lang == 'bg' else obj.button_text_en


