@api_view(['GET'])
@permission_classes([AllowAny])
@conditional_cache('hero_slides')
def get_hero_slides(request):
    """
    Get all active hero slides with language support
    Query parameter: lang (en|bg, default: en)
    Cached for 30 minutes (configurable in admin)
    """
    lang = request.GET.get('lang', 'en')
    
    # Validate language parameter
    if lang not in ['en', 'bg']:
        return Response(
            {'error': 'Invalid language parameter. Use "en" or "bg"'}, 
            status=status.HTTP_400_BAD_REQUEST
        )
    
    # Get all active slides ordered by order field
    slides = HeroSlide.objects.filter(is_active=True).order_by('order', 'id')
    
    # Serialize with language context
    serializer = HeroSlideSerializer(slides, many=True, context={'lang': lang})
    
    return Response(serializer.data)

