@api_view(['GET'])
@permission_classes([AllowAny])
@conditional_cache('call_to_action')
def get_call_to_action(request, name):
    """
    Get a specific Call-to-Action (gradient version) by name with language support
    URL parameter: name (identifier of the CTA)
    Query parameter: lang (en|bg, default: en)
    Cached for 30 minutes (configurable in admin)
    """
    lang = request.GET.get('lang', 'en')
    
    # Validate language parameter
    if lang not in ['en', 'bg']:
        return Response(
            {'error': 'Invalid language parameter. Use "en" or "bg"'}, 
            status=status.HTTP_400_BAD_REQUEST
        )
    
    # Get CTA by name
    try:
        cta = CallToAction.objects.get(name=name, is_active=True)
    except CallToAction.DoesNotExist:
        return Response(
            {'error': f'Call-to-Action with name "{name}" not found or not active'}, 
            status=status.HTTP_404_NOT_FOUND
        )
    
    # Serialize with language context
    serializer = CallToActionSerializer(cta, context={'lang': lang})
    
    return Response(serializer.data)

@api_view(['GET'])
@permission_classes([AllowAny])
@conditional_cache('platform_features')
def get_platform_features(request, slug):
    """
    Get platform features by platform slug with language support
    URL parameter: slug (platform route slug, e.g., 'corporate-business')
    Query parameter: lang (en|bg, default: en)
    Cached for 30 minutes (configurable in admin)
    Returns: Platform info and list of features (maximum 6)
    Response format:
    {
        "platform": {
            "heroTitle": "...",
            "subtitle": "...",
            "title": "...",
            ...
        },
        "features": [...]
    }
    """
    lang = request.GET.get('lang', 'en')
    
    # Validate language parameter
    if lang not in ['en', 'bg']:
        return Response(
            {'error': 'Invalid language parameter. Use "en" or "bg"'}, 
            status=status.HTTP_400_BAD_REQUEST
        )
    
    # Find platform by slug in route
    # Route format: /platforms/corporate-business
    route = f'/platforms/{slug}'
    
    try:
        platform = PlatformCard.objects.get(route=route, is_platform=True, is_active=True)
    except PlatformCard.DoesNotExist:
        return Response(
            {'error': f'Platform with slug "{slug}" not found or not active'}, 
            status=status.HTTP_404_NOT_FOUND
        )
    
    # Get features for this platform (maximum 6, ordered)
    features = PlatformFeature.objects.filter(
        platform=platform,
        is_active=True
    ).order_by('order')[:6]
    
    # Serialize platform and features with language context
    platform_serializer = PlatformCardSerializer(platform, context={'lang': lang})
    features_serializer = PlatformFeatureSerializer(features, many=True, context={'lang': lang})
    
    return Response({
        'platform': platform_serializer.data,
        'features': features_serializer.data
    })

@csrf_exempt  # Disable CSRF protection for this API endpoint
@api_view(['POST', 'OPTIONS'])
@permission_classes([AllowAny])
def contact_form_submit(request):
    """
    Handle contact form submissions and send email via Mailjet
    """
    # Print debug info
    print(f"Request method: {request.method}")
    print(f"Request headers: {request.headers}")
    print(f"Request data: {request.data}")
    
    # Handle preflight OPTIONS request
    if request.method == 'OPTIONS':
        response = JsonResponse({})
        response['Access-Control-Allow-Origin'] = '*'  # Allow any origin
        response['Access-Control-Allow-Methods'] = 'POST, OPTIONS'
        response['Access-Control-Allow-Headers'] = 'Content-Type, X-Requested-With'
        return response
    try:
        # Get form data
        data = request.data
        first_name = data.get('firstName', '')
        last_name = data.get('lastName', '')
        phone = data.get('phone', '')
        email = data.get('email', '')
        message = data.get('message', '')
        
        # Validate required fields
        if not all([first_name, last_name, phone, email, message]):
            return JsonResponse(
                {'error': 'Missing required fields'}, 
                status=status.HTTP_400_BAD_REQUEST
            )
        
        # Format name for display
        full_name = f"{first_name} {last_name}"
        
        # Format message for HTML (replace newlines with <br>)
        message_html = message.replace('\n', '<br>')
        
        # Create email content
        html_content = f"""
        <!DOCTYPE html>
        <html>
        <head>
            <style>
                body {{ font-family: Arial, sans-serif; line-height: 1.6; }}
                .container {{ max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; }}
                .header {{ background-color: #f7f7f7; padding: 15px; margin-bottom: 20px; }}
                .footer {{ margin-top: 30px; font-size: 12px; color: #777; text-align: center; }}
                .field-name {{ font-weight: bold; }}
                .message-content {{ background-color: #f9f9f9; padding: 15px; border-left: 4px solid #007bff; }}
            </style>
        </head>
        <body>
            <div class="container">
                <div class="header">
                    <h2>Ново съобщение от контактната форма</h2>
                </div>
                
                <p><span class="field-name">Име:</span> {full_name}</p>
                <p><span class="field-name">Телефон:</span> {phone}</p>
                <p><span class="field-name">Електронна поща:</span> {email}</p>
                
                <h3>Съобщение:</h3>
                <div class="message-content">
                    {message_html}
                </div>
                
                <div class="footer">
                    <p>Това е автоматично генериран имейл от контактната форма на сайта Generix.</p>
                </div>
            </div>
        </body>
        </html>
        """
        
        text_content = f"""
        Ново съобщение от контактната форма
        
        Име: {full_name}
        Телефон: {phone}
        Електронна поща: {email}
        
        Съобщение:
        {message}
        
        Това е автоматично генериран имейл от контактната форма на сайта Generix.
        """
        
        # Prepare data for Mailjet API
        payload = {
            'Messages': [
                {
                    "From": {
                        "Email": settings.DEFAULT_FROM_EMAIL,
                        "Name": "Generix Contact Form"
                    },
                    "To": [
                        {
                            "Email": settings.CONTACT_FORM_RECIPIENT,  # Will need to be defined in settings
                            "Name": "Generix Team"
                        }
                    ],
                    "Subject": f"Ново запитване от {full_name}",
                    "HTMLPart": html_content,
                    "TextPart": text_content,
                    "CustomID": f"contact-form-{phone}"
                }
            ]
        }
        
        # Create authentication header
        auth_string = f"{settings.MAILJET_API_KEY}:{settings.MAILJET_API_SECRET}"
        auth_bytes = auth_string.encode('ascii')
        auth_b64 = base64.b64encode(auth_bytes).decode('ascii')
        
        # Set headers
        headers = {
            'Content-Type': 'application/json',
            'Authorization': f'Basic {auth_b64}'
        }
        
        # Define API endpoint (with version)
        api_version = getattr(settings, 'MAILJET_API_VERSION', 'v3.1')
        url = f'https://api.mailjet.com/{api_version}/send'
        
        logger.info(f"Sending contact form email from {full_name}")
        
        # Send API request
        response = requests.post(url, headers=headers, json=payload)
        
        # Check response
        if response.status_code == 200:
            logger.info(f"Email sent successfully via Mailjet API: {response.status_code}")
            response_data = {
                'success': True,
                'message': 'Your message has been sent successfully!'
            }
            # Create a response with appropriate headers for CORS
            json_response = JsonResponse(response_data)
            json_response["Access-Control-Allow-Origin"] = "*"
            return json_response
        else:
            logger.warning(f"Mailjet API returned non-200 status code: {response.status_code}")
            error_message = 'Failed to send email'
            error_detail = None
            
            try:
                error_data = response.json()
                logger.error(f"Error details: {json.dumps(error_data)}")
                
                # Check for common Mailjet errors
                if 'Errors' in error_data:
                    for error in error_data['Errors']:
                        if error.get('ErrorCode') == 'mj-0003':  # Sender not verified
                            error_message = "Email sending failed: Sender email is not verified in Mailjet"
                            error_detail = "Please verify the sender email in your Mailjet account"
                        elif error.get('ErrorCode') == 'mj-0013':  # API key authentication failed
                            error_message = "Email sending failed: Invalid API credentials"
                            error_detail = "Please check your Mailjet API key and secret"
            except:
                logger.error(f"Error response: {response.text}")
            
            error_response = JsonResponse({
                'error': error_message,
                'detail': error_detail or 'Check server logs for more details',
                'statusCode': response.status_code
            }, status=status.HTTP_500_INTERNAL_SERVER_ERROR)
            
            error_response["Access-Control-Allow-Origin"] = "*"
            return error_response
    
    except Exception as e:
        logger.error(f"Error in contact_form_submit: {str(e)}", exc_info=True)
        error_response = JsonResponse(
            {'error': 'An unexpected error occurred', 'detail': str(e)}, 
            status=status.HTTP_500_INTERNAL_SERVER_ERROR
        )
        error_response["Access-Control-Allow-Origin"] = "*"
        return error_response


