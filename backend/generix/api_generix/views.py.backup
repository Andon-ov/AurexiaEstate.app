@api_view(['GET'])
@permission_classes([AllowAny])
def search_content(request):
    """
    Global search across all content models with language support
    Query parameters:
        - query (required): Search term
        - lang (optional): Language code (en|bg, default: en)
    Returns:
        List of search results with title, description, category, link, priority
    """
    from django.db.models import Q
    
    query = request.GET.get('query', '').strip()
    lang = request.GET.get('lang', 'en')
    
    # Validate parameters
    if not query:
        return Response(
            {'error': 'Query parameter is required'}, 
            status=status.HTTP_400_BAD_REQUEST
        )
    
    if lang not in ['en', 'bg']:
        lang = 'en'
    
    results = []
    query_lower = query.lower()
    
    # Search in Hero Slides
    hero_slides = HeroSlide.objects.filter(is_active=True)
    for slide in hero_slides:
        title = getattr(slide, f'title_{lang}')
        description = getattr(slide, f'description_{lang}')
        
        if query_lower in title.lower() or query_lower in description.lower():
            results.append({
                'title': title,
                'description': description,
                'category': 'hero',
                'link': '/',
                'priority': 7
            })
    
    # Search in Platform Cards
    platforms = PlatformCard.objects.filter(is_active=True)
    for platform in platforms:
        title = getattr(platform, f'title_{lang}')
        items = platform.get_items_en() if lang == 'en' else platform.get_items_bg()
        items_text = ', '.join(items)
        
        # Search in title and items
        if query_lower in title.lower() or query_lower in items_text.lower():
            results.append({
                'title': title,
                'description': items_text,
                'category': 'platform',
                'link': platform.route if platform.route else '/',
                'priority': 8
            })
        
        # Search in platform features if it's a platform
        if platform.is_platform:
            features = PlatformFeature.objects.filter(platform=platform, is_active=True)
            for feature in features:
                feature_title = getattr(feature, f'title_{lang}')
                feature_desc = getattr(feature, f'description_{lang}')
                
                if query_lower in feature_title.lower() or query_lower in feature_desc.lower():
                    results.append({
                        'title': feature_title,
                        'description': feature_desc,
                        'category': 'feature',
                        'link': platform.route if platform.route else '/',
                        'priority': 6
                    })
    
    # Search in Platforms Section Header
    try:
        platforms_header = PlatformsSectionHeader.load()
        title = getattr(platforms_header, f'title_{lang}')
        subtitle = getattr(platforms_header, f'subtitle_{lang}')
        
        if query_lower in title.lower() or query_lower in subtitle.lower():
            results.append({
                'title': title,
                'description': subtitle,
                'category': 'section',
                'link': '/',
                'priority': 5
            })
    except:
        pass
    
    # Search in Why Generix Section
    try:
        why_generix = WhyGenerixSection.load()
        title = getattr(why_generix, f'title_{lang}')
        para1 = getattr(why_generix, f'paragraph1_{lang}')
        para2 = getattr(why_generix, f'paragraph2_{lang}')
        para3 = getattr(why_generix, f'paragraph3_{lang}')
        
        full_text = f"{title} {para1} {para2} {para3}".lower()
        
        if query_lower in full_text:
            results.append({
                'title': title,
                'description': para1[:200] + '...' if len(para1) > 200 else para1,
                'category': 'about',
                'link': '/about',
                'priority': 4
            })
    except:
        pass
    
    # Search in Case Study Slides
    case_studies = CaseStudySlide.objects.filter(is_active=True)
    for case in case_studies:
        title = getattr(case, f'title_{lang}')
        category = getattr(case, f'category_{lang}')
        
        if query_lower in title.lower() or query_lower in category.lower():
            results.append({
                'title': title,
                'description': category,
                'category': 'case_study',
                'link': case.button_link if case.button_link else '/about',
                'priority': 5
            })
    
    # Search in About Page Hero
    try:
        about_hero = AboutPageHero.load()
        title = getattr(about_hero, f'hero_title_{lang}')
        para1 = getattr(about_hero, f'paragraph1_{lang}')
        para2 = getattr(about_hero, f'paragraph2_{lang}')
        para3 = getattr(about_hero, f'paragraph3_{lang}')
        
        full_text = f"{title} {para1} {para2} {para3}".lower()
        
        if query_lower in full_text:
            results.append({
                'title': title,
                'description': para1[:200] + '...' if len(para1) > 200 else para1,
                'category': 'about',
                'link': '/about',
                'priority': 8
            })
    except:
        pass
    
    # Search in Testimonials
    testimonials = TestimonialCard.objects.filter(is_active=True)
    for testimonial in testimonials:
        name = getattr(testimonial, f'name_{lang}')
        description = getattr(testimonial, f'description_{lang}')
        
        if query_lower in name.lower() or query_lower in description.lower():
            results.append({
                'title': f"{name} - Testimonial",
                'description': description,
                'category': 'testimonial',
                'link': '/#testimonials',
                'priority': 3
            })
    
    # Search in Call to Actions
    ctas = CallToAction.objects.filter(is_active=True)
    for cta in ctas:
        title = getattr(cta, f'title_{lang}')
        description = getattr(cta, f'description_{lang}')
        
        if query_lower in title.lower() or query_lower in description.lower():
            results.append({
                'title': title,
                'description': description,
                'category': 'cta',
                'link': cta.button_link if cta.button_link else '/contact',
                'priority': 4
            })
    
    # Search in About Us Image Content (Purpose section)
    try:
        from .models import AboutUsImageContent
        about_us_image = AboutUsImageContent.load()
        purpose_title = getattr(about_us_image, f'purpose_title_{lang}')
        purpose_description = getattr(about_us_image, f'purpose_description_{lang}')
        purpose_text = getattr(about_us_image, f'purpose_text_{lang}')
        
        full_text = f"{purpose_title} {purpose_description} {purpose_text}".lower()
        
        if query_lower in full_text:
            results.append({
                'title': purpose_title,
                'description': purpose_description,
                'category': 'about',
                'link': '/about#purpose',
                'priority': 7
            })
    except:
        pass
    
    # Search in About Page Achievements Header
    try:
        from .models import AboutPageAchievements
        achievements = AboutPageAchievements.load()
        title = getattr(achievements, f'title_{lang}')
        subtitle = getattr(achievements, f'subtitle_{lang}')
        
        if query_lower in title.lower() or query_lower in subtitle.lower():
            results.append({
                'title': title,
                'description': subtitle,
                'category': 'about',
                'link': '/about#achievements',
                'priority': 6
            })
    except:
        pass
    
    # Search in Contact Page Content
    try:
        contact = ContactPageContent.load()
        title = getattr(contact, f'title_{lang}')
        subtitle = getattr(contact, f'subtitle_{lang}')
        
        if query_lower in title.lower() or query_lower in subtitle.lower():
            results.append({
                'title': title,
                'description': subtitle,
                'category': 'contact',
                'link': '/contact',
                'priority': 6
            })
    except:
        pass
    
    # Remove duplicates and sort by priority
    seen = set()
    unique_results = []
    for result in results:
        key = (result['title'], result['description'])
        if key not in seen:
            seen.add(key)
            unique_results.append(result)
    
    # Sort by priority (highest first)
    unique_results.sort(key=lambda x: x['priority'], reverse=True)
    
    return Response(unique_results)


@api_view(['GET'])
@permission_classes([AllowAny])
def get_cache_settings(request):
    """
    Get cache settings for Angular frontend
    Returns cache_enabled and cache_timeout from CacheSettings model
    """
    from .models import CacheSettings
    
    try:
        settings = CacheSettings.objects.first()
        if not settings:
            # Return default settings if not configured
            return Response({
                'cache_enabled': True,
                'cache_timeout': 1800  # 30 minutes in seconds
            })
        
        return Response({
            'cache_enabled': settings.cache_enabled,
            'cache_timeout': settings.cache_timeout
        })
    except Exception as e:
        logger.error(f"Error fetching cache settings: {str(e)}")
        return Response({
            'cache_enabled': True,
            'cache_timeout': 1800
        })
