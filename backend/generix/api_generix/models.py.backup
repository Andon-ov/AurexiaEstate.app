        help_text="Текст на бутона на български",
        default="Свържете се с нас"
    )
    
    # Общи полета
    button_link = models.CharField(
        max_length=200,
        verbose_name="Button Link",
        help_text="URL or Angular route (e.g., /contact)",
        default="/contact"
    )
    
    # Metadata
    order = models.IntegerField(
        default=0,
        verbose_name="Order",
        help_text="Display order (lower numbers appear first)"
    )
    is_active = models.BooleanField(
        default=True,
        verbose_name="Active",
        help_text="Show this CTA on the website"
    )
    
    # Timestamps
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    class Meta:
        ordering = ['order', 'id']
        verbose_name = "Call-to-Action (Gradient)"
        verbose_name_plural = "Call-to-Actions (Gradient)"
    
    def __str__(self):
        return f"{self.name} - {self.title_en}"


