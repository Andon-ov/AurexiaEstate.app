        max_length=200,
        blank=True,
        verbose_name="Hero Title (English)",
        help_text="Platform page hero title (only for platforms)"
    )
    hero_title_bg = models.CharField(
        max_length=200,
        blank=True,
        verbose_name="Hero заглавие (Български)",
        help_text="Заглавие в hero секцията на страницата (само за платформи)"
    )
    
    # Subtitle в следващата секция
    subtitle_en = models.TextField(
        blank=True,
        verbose_name="Subtitle (English)",
        help_text="Platform page subtitle/description (only for platforms)"
    )
    subtitle_bg = models.TextField(
        blank=True,
        verbose_name="Подзаглавие (Български)",
        help_text="Подзаглавие/описание на страницата (само за платформи)"
    )
    
    # Metadata
    order = models.IntegerField(
        default=0,
        verbose_name="Order",
        help_text="Display order (lower numbers appear first)"
    )
    is_active = models.BooleanField(
        default=True,
        verbose_name="Active",
        help_text="Show this card on the website"
    )
    
    # Timestamps
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    class Meta:
        ordering = ['order', 'id']
        verbose_name = "Platform Card"
        verbose_name_plural = "Platform Cards"
    
    def __str__(self):
        return f"{self.title_en} (Order: {self.order})"
    
    def get_items_en(self):
        """Return list of non-empty English items"""
        items = [self.item1_en, self.item2_en, self.item3_en, self.item4_en]
        return [item for item in items if item]
    
    def get_items_bg(self):
        """Return list of non-empty Bulgarian items"""
        items = [self.item1_bg, self.item2_bg, self.item3_bg, self.item4_bg]
        return [item for item in items if item]


class PlatformFeature(models.Model):
    """
    Features/карти за конкретна платформа
    Максимум 6 карти на платформа
    """
    platform = models.ForeignKey(
        PlatformCard,
        on_delete=models.CASCADE,
        limit_choices_to={'is_platform': True},
        related_name='features',
        verbose_name="Platform",
        help_text="Select platform (only cards marked as 'Platform')"
    )
    
    # Английски език
    title_en = models.CharField(
        max_length=200,
        verbose_name="Title (English)",
        help_text="Feature title in English"
    )
    description_en = models.TextField(
        verbose_name="Description (English)",
        help_text="Feature description in English"
    )
    
    # Български език
    title_bg = models.CharField(
        max_length=200,
        verbose_name="Заглавие (Български)",
        help_text="Заглавие на функционалността на български"
    )
    description_bg = models.TextField(
        verbose_name="Описание (Български)",
        help_text="Описание на функционалността на български"
    )
    
    # Общи полета
    icon_url = models.URLField(
        verbose_name="Icon URL",
        help_text="URL to icon (Cloudinary SVG or image URL)"
    )
    
    # Metadata
    order = models.IntegerField(
        default=0,
        verbose_name="Order",
        help_text="Display order (lower numbers appear first)"
    )
    is_active = models.BooleanField(
        default=True,
        verbose_name="Active",
        help_text="Show this feature on the website"
    )
    
    # Timestamps
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)
    
    class Meta:
        ordering = ['platform', 'order', 'id']
        verbose_name = "Platform Feature"
        verbose_name_plural = "Platform Features"
        unique_together = [['platform', 'order']]
    
    def __str__(self):
        return f"{self.platform.title_en} - {self.title_en}"
    
    def save(self, *args, **kwargs):
        """
        Validate that platform has maximum 6 active features
        """
        # If platform is not set yet, defer validation to normal save
        platform_id = getattr(self, 'platform_id', None)
        if platform_id is None:
            return super().save(*args, **kwargs)

        # Only validate when this feature will be active
        if self.is_active:
            # Count active features for this platform excluding this instance (use platform_id to avoid object equality issues)
            active_qs = PlatformFeature.objects.filter(
                platform_id=platform_id,
                is_active=True
            )
            if self.pk:
                active_qs = active_qs.exclude(pk=self.pk)

            active_count = active_qs.count()
            if active_count >= 6:
                from django.core.exceptions import ValidationError
                # Try to get platform title safely
                platform_title = getattr(self.platform, 'title_en', str(platform_id))
                raise ValidationError(
                    f'Maximum 6 active features allowed per platform. '
                    f'"{platform_title}" already has {active_count} active features. '
                    f'Please deactivate an existing feature before adding a new one.'
                )
        
        super().save(*args, **kwargs)


